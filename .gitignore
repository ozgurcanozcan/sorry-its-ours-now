# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Autogenerated project files — her arac kendi uretir, commit edilmez
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vsconfig

*.pidb.meta
*.pdb.meta
*.mdb.meta

sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

crashlytics-build.properties

/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------
# IDE — arac ayarlari kisiseldir, kural dosyalari degil
# ---------------------------------------------
.idea/
.vs/
.vscode/
.cursor/
.cursorignore
# .cursorrules ve CLAUDE.md BILEREK izlenir — ortak kurallar

# ---------------------------------------------
# Blender
# ---------------------------------------------
*.blend1
*.blend2

# ---------------------------------------------
# OS
# ---------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------
# Blender script ciktilari - kaynak script, cikti degil
# ---------------------------------------------
/Kaynak/Blender/cikti/
/Kaynak/Blender/**/cikti/

# ---------------------------------------------
# Ic ice olusmus Unity projeleri
# Unity Hub yanlislikla repo icinde proje olusturursa buraya dusuyor.
# Kok Assets/ Library/ kurallari alt klasorleri kapsamiyor.
# ---------------------------------------------
/*/Library/
/*/Temp/
/*/Logs/
/*/UserSettings/
/Sorry It's Ours Now/
